import { LineEdit, Switch, Slider, ComboBox, Button, ScrollView } from "std-widgets.slint";

export struct Video {
    id: string,
    title: string,
    channel: string,
    meta: string,
    duration: string,
    live: bool,
    thumb: image,
}

export struct Topic {
    name: string,
    picked: bool,
}

export global Theme {
    in-out property <bool> glass: true;
    in-out property <bool> dark: true;
    in-out property <bool> aurora: true;
    in-out property <bool> translucent: false;
    in-out property <color> accent: #ff3d5a;
    in-out property <length> radius: 18px;
    in-out property <float> tint: 0.10;
    in-out property <float> rim: 0.28;
    out property <color> fg: dark ? #f2f2f7 : #15151b;
    out property <color> muted: dark ? #f2f2f7a0 : #15151ba0;
    out property <color> base: dark ? #0b0b10 : #f3f3f8;
    out property <color> panel: dark ? #191920 : #ffffff;
    out property <color> line: dark ? #ffffff18 : #0000001a;
}

// Vector icons (24x24 viewbox) so they render with any font.
export global Icons {
    out property <string> play: "M8 5 L19 12 L8 19 Z";
    out property <string> pause: "M6 5 L10 5 L10 19 L6 19 Z M14 5 L18 5 L18 19 L14 19 Z";
    out property <string> next: "M6 6 L15 12 L6 18 Z M16 6 L18 6 L18 18 L16 18 Z";
    out property <string> prev: "M18 6 L9 12 L18 18 Z M6 6 L8 6 L8 18 L6 18 Z";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> chevron-right: "M9 6 L15 12 L9 18";
    out property <string> fullscreen: "M4 9 L4 4 L9 4 M15 4 L20 4 L20 9 M20 15 L20 20 L15 20 M9 20 L4 20 L4 15";
    out property <string> exit-fullscreen: "M9 4 L9 9 L4 9 M15 4 L15 9 L20 9 M20 15 L15 15 L15 20 M4 15 L9 15 L9 20";
    out property <string> volume: "M4 9 L8 9 L13 5 L13 19 L8 15 L4 15 Z";
    out property <string> home: "M4 11 L12 4 L20 11 L20 20 L14 20 L14 14 L10 14 L10 20 L4 20 Z";
    out property <string> subs: "M4 7 L20 7 L20 19 L4 19 Z M7 4 L17 4 M10 10 L15 13 L10 16 Z";
    out property <string> search: "M10.5 4 A6.5 6.5 0 1 1 10.49 4 M15.5 15.5 L20 20";
    out property <string> history: "M4 12 A8 8 0 1 0 6.5 6.2 M4 4 L4 9 L9 9 M12 8 L12 12 L15 14";
    out property <string> check: "M5 12 L10 17 L19 7";
}

component Icon inherits Path {
    in property <string> d;
    in property <bool> filled: true;
    in property <color> tint: white;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: filled ? tint : transparent;
    stroke: filled ? transparent : tint;
    stroke-width: filled ? 0px : 2px;
    width: 22px;
    height: 22px;
}

// The surface everything is built from: translucent "liquid glass" with a
// lit rim, or an opaque solid panel.
component Surface inherits Rectangle {
    in property <length> r: Theme.radius;
    in property <float> strength: 1.0;
    border-radius: r;
    background: Theme.glass
        ? @linear-gradient(135deg,
            Theme.dark ? rgba(255, 255, 255, Theme.tint * 1.6 * strength) : rgba(255, 255, 255, 0.55 * strength) 0%,
            Theme.dark ? rgba(255, 255, 255, Theme.tint * 0.4 * strength) : rgba(255, 255, 255, 0.30 * strength) 100%)
        : Theme.panel;
    border-width: 1px;
    border-color: Theme.glass ? rgba(255, 255, 255, Theme.rim) : Theme.line;
    drop-shadow-blur: Theme.glass ? 30px : 12px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.dark ? #0000005a : #00000020;
    // top specular sheen
    if Theme.glass: Rectangle {
        y: 1px;
        height: parent.height * 0.45;
        border-radius: root.r;
        background: @linear-gradient(180deg, rgba(255, 255, 255, Theme.rim * 0.35) 0%, rgba(255, 255, 255, 0) 100%);
    }
}

component Aurora inherits Rectangle {
    property <float> t: Theme.aurora ? animation-tick() / 40s : 0;
    background: Theme.translucent ? Theme.base.with-alpha(0.5) : Theme.base;
    clip: true;
    Rectangle {
        x: parent.width * (0.05 + 0.08 * Math.sin(t * 360deg)) - self.width / 2 + parent.width * 0.1;
        y: parent.height * (0.10 + 0.08 * Math.cos(t * 288deg)) - self.height / 2 + parent.height * 0.1;
        width: max(parent.width, parent.height) * 1.1;
        height: self.width;
        background: @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.45 : 0.30) 0%, Theme.accent.with-alpha(0) 60%);
    }
    Rectangle {
        x: parent.width * (0.85 + 0.08 * Math.cos(t * 360deg + 120deg)) - self.width / 2;
        y: parent.height * (0.30 + 0.08 * Math.sin(t * 288deg + 120deg)) - self.height / 2;
        width: max(parent.width, parent.height) * 0.9;
        height: self.width;
        background: @radial-gradient(circle, #6c5cff.with-alpha(Theme.dark ? 0.35 : 0.22) 0%, #6c5cff00 60%);
    }
    Rectangle {
        x: parent.width * (0.55 + 0.08 * Math.sin(t * 360deg + 240deg)) - self.width / 2;
        y: parent.height * (0.95 + 0.06 * Math.cos(t * 288deg + 240deg)) - self.height / 2;
        width: max(parent.width, parent.height) * 1.0;
        height: self.width;
        background: @radial-gradient(circle, #1ed6c3.with-alpha(Theme.dark ? 0.28 : 0.18) 0%, #1ed6c300 60%);
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> icon;
    in property <bool> filled: true;
    in property <bool> selected;
    callback clicked();
    height: 44px;
    border-radius: Theme.radius * 0.7;
    background: selected ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.fg.with-alpha(0.06) : transparent);
    animate background { duration: 150ms; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 14px;
        if icon != "": Icon { d: icon; filled: filled; tint: selected ? Theme.accent : Theme.fg; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
        if icon == "": Text { text: glyph; font-size: 18px; color: selected ? Theme.accent : Theme.fg; vertical-alignment: center; width: 20px; }
        Text { text: label; font-size: 14px; font-weight: selected ? 700 : 500; color: Theme.fg; vertical-alignment: center; }
    }
}

component Card inherits Rectangle {
    in property <Video> video;
    in property <bool> dismissable;
    callback clicked();
    callback dismiss();
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        // Right-click: Not interested.
        pointer-event(e) => {
            if (root.dismissable && e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.dismiss();
            }
        }
    }
    VerticalLayout {
        spacing: 10px;
        thumb := Rectangle {
            height: self.width * 9 / 16;
            border-radius: Theme.radius * 0.8;
            clip: true;
            background: Theme.fg.with-alpha(0.06);
            Image { source: video.thumb; image-fit: cover; width: 100%; height: 100%; }
            Rectangle {
                background: ta.has-hover ? #00000030 : #00000000;
                animate background { duration: 150ms; }
            }
            // Stays up while the pointer is on the card or on the pill itself.
            Rectangle {
                visible: dismissable && (ta.has-hover || nope-ta.has-hover);
                y: 8px;
                width: nope.preferred-width + 16px;
                height: 24px;
                border-radius: 12px;
                background: nope-ta.has-hover ? #000000e0 : #000000a8;
                nope := Text { text: "âœ•  Not interested"; color: white; font-size: 12px; font-weight: 600; }
                nope-ta := TouchArea { clicked => { root.dismiss(); } mouse-cursor: pointer; }
                x: parent.width - self.width - 8px;
            }
            if video.duration != "" || video.live: Rectangle {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                width: badge.preferred-width + 12px;
                height: 20px;
                border-radius: 6px;
                background: video.live ? #e3002b : #000000b8;
                badge := Text { text: video.live ? "LIVE" : video.duration; color: white; font-size: 12px; font-weight: 600; }
            }
        }
        Text {
            text: video.title;
            color: Theme.fg;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            height: 38px;
        }
        Text { text: video.channel + (video.meta != "" ? "  Â·  " + video.meta : ""); color: Theme.muted; font-size: 12px; overflow: elide; }
    }
}

component Swatch inherits Rectangle {
    in property <color> c;
    callback picked(color);
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: c;
    border-width: Theme.accent == c ? 3px : 0px;
    border-color: Theme.fg;
    TouchArea { clicked => { root.picked(root.c); } mouse-cursor: pointer; }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: 36px;
    border-radius: 18px;
    background: on ? Theme.accent : (cta.has-hover ? Theme.fg.with-alpha(0.14) : Theme.fg.with-alpha(0.08));
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.line;
    animate background { duration: 120ms; }
    Text { text: label; color: on ? white : Theme.fg; font-size: 14px; font-weight: on ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
    cta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Topic picker: the welcome screen of the session feed, and its "Tune" dialog.
component TopicPanel inherits Surface {
    in property <string> heading;
    in property <string> body;
    in property <[Topic]> topics;
    in property <bool> tuning;
    in property <bool> signed-in;
    callback toggle(int);
    callback build();
    callback start-fresh();
    callback cancel();
    property <int> per-row: 6;
    property <length> chip-w: 108px;
    property <length> chip-gap: 10px;
    width: per-row * chip-w + (per-row - 1) * chip-gap + 64px;
    height: lay.preferred-height;
    // As a dialog over a busy feed, glass would be unreadable: go solid.
    background: tuning || !Theme.glass ? Theme.panel
        : @linear-gradient(135deg,
            Theme.dark ? rgba(255, 255, 255, Theme.tint * 1.6) : rgba(255, 255, 255, 0.55) 0%,
            Theme.dark ? rgba(255, 255, 255, Theme.tint * 0.4) : rgba(255, 255, 255, 0.30) 100%);
    lay := VerticalLayout {
        padding: 32px;
        spacing: 16px;
        Text { text: heading; font-size: 28px; font-weight: 800; color: Theme.fg; horizontal-alignment: center; }
        Text { text: body; color: Theme.fg.with-alpha(0.85); font-size: 15px; wrap: word-wrap; horizontal-alignment: center; }
        Rectangle {
            height: ceil(topics.length / per-row) * (36px + chip-gap) - chip-gap;
            for t[i] in topics: Chip {
                label: t.name;
                on: t.picked;
                width: chip-w;
                x: mod(i, per-row) * (chip-w + chip-gap);
                y: floor(i / per-row) * (36px + chip-gap);
                clicked => { root.toggle(i); }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            if tuning: Button { text: "Start fresh"; clicked => { root.start-fresh(); } }
            if tuning: Button { text: "Cancel"; clicked => { root.cancel(); } }
            Button { text: tuning ? "Save" : "Build my feed"; primary: true; clicked => { root.build(); } }
        }
        if !tuning && !signed-in: Text {
            text: "Want your real YouTube recommendations instead? Connect your account in Settings â†’ Account.";
            color: Theme.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap;
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> filled: true;
    in property <length> size: 22px;
    in property <length> pad: 9px;
    in property <bool> ring;            // translucent circle behind (center controls)
    callback clicked();
    width: size + pad * 2;
    height: self.width;
    border-radius: self.width / 2;
    background: ita.pressed ? #ffffff40 : (ita.has-hover ? #ffffff26 : (ring ? #00000059 : transparent));
    animate background { duration: 120ms; }
    Icon { d: icon; filled: filled; width: size; height: size; }
    ita := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Seek / volume bar: click or drag anywhere on it.
component Scrub inherits Rectangle {
    in property <float> value;     // 0..1
    callback scrubbed(float);      // while dragging
    callback committed(float);     // on release
    property <float> shown: sta.pressed ? clamp(sta.mouse-x / self.width, 0, 1) : value;
    height: 18px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: sta.has-hover || sta.pressed ? 6px : 4px;
        border-radius: 3px;
        background: #ffffff40;
        Rectangle { x: 0; width: parent.width * shown; border-radius: 3px; background: Theme.accent; }
    }
    Rectangle {
        x: parent.width * shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: sta.has-hover || sta.pressed ? 14px : 0px;
        height: self.width;
        border-radius: self.width / 2;
        background: white;
        animate width { duration: 100ms; }
    }
    sta := TouchArea {
        mouse-cursor: pointer;
        moved => { if (self.pressed) { root.scrubbed(clamp(self.mouse-x / root.width, 0, 1)); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.committed(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> chevron: true;
    in property <bool> selected;
    callback clicked();
    height: 48px;
    border-radius: 10px;
    background: rta.has-hover ? #ffffff14 : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: label; color: white; font-size: 15px; vertical-alignment: center; }
        Rectangle { }
        Text { text: value; color: #ffffffa0; font-size: 14px; vertical-alignment: center; }
        if chevron: Icon { d: Icons.chevron-right; filled: false; tint: #ffffffa0; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
        if selected: Icon { d: Icons.check; filled: false; tint: Theme.accent; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
    }
    rta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 16px;
    Text { text: label; color: Theme.fg; font-size: 14px; vertical-alignment: center; width: 200px; }
    @children
}

export component AppWindow inherits Window {
    title: "Null YT";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 480px;
    min-height: 560px;
    background: Theme.translucent ? transparent : Theme.base;
    default-font-family: "Inter";

    in-out property <int> page: 0;
    in-out property <[Video]> videos;
    in-out property <string> status;
    in-out property <bool> loading;
    in-out property <string> account-label: "Not signed in";
    in-out property <bool> signed-in;
    in-out property <int> columns: 0;
    in-out property <bool> hide-shorts;
    in-out property <bool> hide-live;
    in-out property <bool> send-history: true;
    in-out property <int> quality-index: 5;
    in-out property <string> player: "mpv";
    in-out property <int> effect-index: 0;
    in-out property <string> blocked: "";
    // Session "For you" feed
    in-out property <bool> session-home;      // Home is showing the session mix
    in-out property <bool> show-welcome;      // no taste yet: topic picker instead of a feed
    in-out property <bool> tune-open;
    in-out property <[Topic]> topics;
    in-out property <bool> foryou-remember: true;
    in-out property <int> signal-count;
    // Built-in player (page 5)
    in-out property <image> player-frame;
    in-out property <string> player-title;
    in-out property <string> player-channel;
    in-out property <float> player-progress;   // 0..1
    in-out property <string> player-time;      // "1:02 / 10:00"
    in-out property <bool> player-paused;
    in-out property <float> player-volume: 1.0; // 0..1.3
    in-out property <string> player-status;    // loading / error text over the video
    in-out property <bool> player-has-next;
    in-out property <bool> fullscreen;
    in-out property <bool> embedded-player: true;
    in-out property <bool> player-controls: true;  // overlay shown (auto-hides while playing)
    in-out property <string> player-chapter;
    in-out property <[float]> player-chapters;     // chapter starts, 0..1
    in-out property <bool> player-captions;
    in-out property <float> player-speed: 1.0;
    in-out property <int> player-quality-index: 5;
    in-out property <string> player-sleep: "Off";
    in-out property <int> sheet: 0;                // 0 closed, 1 menu, 2 quality, 3 speed, 4 sleep
    in-out property <string> player-next-title;
    in-out property <image> player-next-thumb;

    callback open-page(int);
    callback search(string);
    callback play(int);
    callback refresh();
    callback settings-changed();
    callback use-browser(string);
    callback import-cookies();
    callback sign-out();
    callback toggle-topic(int);
    callback save-topics();
    callback start-fresh();
    callback cancel-tune();
    callback open-tune();
    callback not-interested(int);
    callback set-home-session(bool);
    callback player-toggle();
    callback player-seek(float);     // 0..1
    callback player-skip(float);     // seconds, relative
    callback player-close();
    callback player-set-volume(float);
    callback player-next();
    callback toggle-fullscreen();
    callback player-activity();
    callback player-prev();
    callback player-toggle-captions();
    callback player-set-speed(float);
    callback player-set-quality(int);
    callback player-set-sleep(int);    // minutes; 0 off, -1 end of video

    property <length> gap: 20px;
    property <int> auto-cols: max(1, ceil(content.width / 360px));
    property <int> cols: columns > 0 ? columns : auto-cols;
    property <length> card-w: (content.width - gap * (cols + 1)) / cols;
    property <length> card-h: card-w * 9 / 16 + 90px;
    property <[string]> titles: ["For you", "Subscriptions", "Search", "History", "Settings"];
    property <bool> welcome: page == 0 && session-home && show-welcome;

    Aurora { }

    HorizontalLayout {
        padding: page == 5 && fullscreen ? 0px : 12px;
        spacing: 12px;

        if !(page == 5 && fullscreen): Surface {
            width: 220px;
            strength: 1.2;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text { text: "Null YT"; font-size: 22px; font-weight: 900; color: Theme.fg; height: 56px; vertical-alignment: center; x: 14px; }
                NavItem { label: "Home"; icon: Icons.home; selected: page == 0; clicked => { open-page(0); } }
                NavItem { label: "Subscriptions"; icon: Icons.subs; filled: false; selected: page == 1; clicked => { open-page(1); } }
                NavItem { label: "Search"; icon: Icons.search; filled: false; selected: page == 2; clicked => { open-page(2); } }
                NavItem { label: "History"; icon: Icons.history; filled: false; selected: page == 3; clicked => { open-page(3); } }
                Rectangle { }
                NavItem { label: "Settings"; glyph: "âš™"; selected: page == 4; clicked => { open-page(4); } }
            }
        }

        content := Rectangle {
            // â”€â”€ Feeds â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            if page != 4 && page != 5: VerticalLayout {
                padding-top: 16px;
                spacing: 12px;
                HorizontalLayout {
                    padding-left: gap;
                    padding-right: gap;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: titles[page]; font-size: 36px; font-weight: 800; color: Theme.fg; letter-spacing: -1px; }
                        if page == 0: Text {
                            text: session-home ? "Learns from what you watch, search and skip in this session" : "Synced with your YouTube account";
                            color: Theme.muted; font-size: 13px;
                        }
                    }
                    Rectangle { }
                    if page == 0 && signed-in: HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Chip { label: "YouTube"; on: !session-home; width: 96px; clicked => { set-home-session(false); } }
                        Chip { label: "Session mix"; on: session-home; width: 116px; clicked => { set-home-session(true); } }
                    }
                    if page == 0 && session-home && !show-welcome: Button { text: "Topics"; clicked => { open-tune(); } }
                    if page == 2: Surface {
                        width: 420px;
                        r: 999px;
                        height: 44px;
                        q := LineEdit {
                            x: 12px;
                            width: parent.width - 24px;
                            placeholder-text: "Search YouTube";
                            accepted => { search(self.text); }
                        }
                    }
                    Button { text: "Refresh"; clicked => { refresh(); } }
                }
                if status != "": Surface {
                    height: 48px;
                    Text { text: status; color: Theme.fg; wrap: word-wrap; x: 16px; width: parent.width - 32px; vertical-alignment: center; }
                }
                if welcome: Rectangle {
                    TopicPanel {
                        heading: "Your feed, no account needed";
                        body: "Watch or search anything and Home becomes a For You feed that follows what you're into right now, the way YouTube does for a signed-out session. Pick a few topics to start, or just search.";
                        topics: topics;
                        signed-in: signed-in;
                        toggle(i) => { toggle-topic(i); }
                        build => { save-topics(); }
                    }
                }
                if !welcome: ScrollView {
                    content-height: ceil(videos.length / cols) * (card-h + gap) + gap;
                    content-width: self.visible-width;
                    for v[i] in videos: Card {
                        video: v;
                        x: gap + mod(i, cols) * (card-w + gap);
                        y: gap + floor(i / cols) * (card-h + gap);
                        width: card-w;
                        height: card-h;
                        dismissable: page == 0 && session-home;
                        clicked => { play(i); }
                        dismiss => { not-interested(i); }
                    }
                }
            }

            // â”€â”€ Player â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            if page == 5: Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: fullscreen ? 0px : Theme.radius;
                clip: true;
                background: black;
                keys := FocusScope {
                    init => { self.focus(); }
                    key-pressed(e) => {
                        player-activity();
                        if (e.text == " " || e.text == "k") { player-toggle(); return accept; }
                        if (e.text == Key.LeftArrow || e.text == "j") { player-skip(-10); return accept; }
                        if (e.text == Key.RightArrow || e.text == "l") { player-skip(10); return accept; }
                        if (e.text == Key.UpArrow) { player-set-volume(min(1.3, player-volume + 0.05)); return accept; }
                        if (e.text == Key.DownArrow) { player-set-volume(max(0, player-volume - 0.05)); return accept; }
                        if (e.text == "f") { toggle-fullscreen(); return accept; }
                        if (e.text == "c") { player-toggle-captions(); return accept; }
                        if (e.text == "n") { player-next(); return accept; }
                        if (e.text == "p") { player-prev(); return accept; }
                        if (e.text == Key.Escape) {
                            if (sheet != 0) { sheet = 0; } else if (fullscreen) { toggle-fullscreen(); } else { player-close(); }
                            return accept;
                        }
                        reject
                    }

                    Image { source: player-frame; image-fit: contain; width: 100%; height: 100%; }

                    // Anywhere on the video: move shows the controls, click
                    // shows/hides them (or pauses when they're already up),
                    // double-click toggles fullscreen.
                    TouchArea {
                        mouse-cursor: player-controls ? MouseCursor.default : MouseCursor.none;
                        moved => { player-activity(); }
                        clicked => {
                            keys.focus();
                            if (player-controls) { player-toggle(); }
                            player-activity();
                        }
                        double-clicked => { toggle-fullscreen(); }
                        pointer-event(e) => { if (e.kind == PointerEventKind.move) { player-activity(); } }
                    }

                    if player-status != "": Rectangle {
                        width: st.preferred-width + 40px;
                        height: 44px;
                        border-radius: 22px;
                        background: #000000b0;
                        st := Text { text: player-status; color: white; font-size: 14px; }
                    }

                    // â”€â”€ Overlay â”€â”€
                    Rectangle {
                        opacity: player-controls || sheet != 0 ? 1 : 0;
                        visible: self.opacity > 0.01;
                        animate opacity { duration: 180ms; }
                        background: #00000070;

                        // Top: chevron, title / channel, captions, settings
                        HorizontalLayout {
                            y: 0;
                            height: 76px;
                            padding: 14px;
                            padding-left: 10px;
                            spacing: 6px;
                            IconBtn { icon: Icons.chevron-down; filled: false; size: 26px; clicked => { player-close(); } }
                            VerticalLayout {
                                alignment: center;
                                Text { text: player-title; color: white; font-size: fullscreen ? 22px : 17px; font-weight: 800; overflow: elide; }
                                Text { text: player-channel; color: #ffffffb8; font-size: 13px; overflow: elide; }
                            }
                            // CC badge
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: cca.has-hover ? #ffffff26 : transparent;
                                y: (parent.height - parent.padding * 2 - self.height) / 2;
                                Rectangle {
                                    width: 28px;
                                    height: 20px;
                                    border-radius: 4px;
                                    border-width: 2px;
                                    border-color: white;
                                    background: player-captions ? white : transparent;
                                    Text { text: "CC"; font-size: 10px; font-weight: 900; color: player-captions ? black : white; }
                                }
                                cca := TouchArea { clicked => { player-toggle-captions(); keys.focus(); } mouse-cursor: pointer; }
                            }
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: gea.has-hover ? #ffffff26 : transparent;
                                Text { text: "âš™"; color: white; font-size: 22px; }
                                gea := TouchArea { clicked => { sheet = sheet == 0 ? 1 : 0; } mouse-cursor: pointer; }
                            }
                        }

                        // Center: previous, play/pause, next
                        play-btn := IconBtn {
                            icon: player-paused ? Icons.play : Icons.pause; ring: true; size: 38px; pad: 23px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            clicked => { player-toggle(); keys.focus(); }
                        }
                        IconBtn {
                            icon: Icons.prev; ring: true; size: 26px; pad: 18px;
                            x: play-btn.x - min(160px, parent.width / 7) - self.width / 2 + play-btn.width / 2;
                            y: (parent.height - self.height) / 2;
                            clicked => { player-prev(); keys.focus(); }
                        }
                        IconBtn {
                            icon: Icons.next; ring: true; size: 26px; pad: 18px;
                            x: play-btn.x + min(160px, parent.width / 7) - self.width / 2 + play-btn.width / 2;
                            y: (parent.height - self.height) / 2;
                            clicked => { player-next(); keys.focus(); }
                        }

                        // Up next card (bottom right, above the bar)
                        if player-has-next: Rectangle {
                            x: parent.width - self.width - 18px;
                            y: parent.height - self.height - 74px;
                            width: 300px;
                            height: 64px;
                            border-radius: 14px;
                            background: una.has-hover ? #ffffff2a : #00000090;
                            border-width: 1px;
                            border-color: #ffffff30;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                Rectangle {
                                    width: 85px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: #ffffff14;
                                    Image { source: player-next-thumb; image-fit: cover; width: 100%; height: 100%; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: "Up next"; color: #ffffffa0; font-size: 11px; font-weight: 700; }
                                    Text { text: player-next-title; color: white; font-size: 13px; font-weight: 600; overflow: elide; }
                                }
                            }
                            una := TouchArea { clicked => { player-next(); keys.focus(); } mouse-cursor: pointer; }
                        }

                        // Bottom: time Â· chapter, volume, fullscreen, then the bar
                        VerticalLayout {
                            y: parent.height - self.height;
                            height: 74px;
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-bottom: 8px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                height: 44px;
                                Text { text: player-time; color: white; font-size: 15px; vertical-alignment: center; }
                                if player-chapter != "": Text { text: "Â·  " + player-chapter; color: white; font-size: 15px; vertical-alignment: center; overflow: elide; }
                                Rectangle { }
                                Icon { d: Icons.volume; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                                Scrub {
                                    width: 110px;
                                    value: player-volume / 1.3;
                                    scrubbed(v) => { player-set-volume(v * 1.3); }
                                    committed(v) => { player-set-volume(v * 1.3); keys.focus(); }
                                }
                                IconBtn { icon: fullscreen ? Icons.exit-fullscreen : Icons.fullscreen; filled: false; clicked => { toggle-fullscreen(); keys.focus(); } }
                            }
                            Rectangle {
                                height: 18px;
                                Scrub {
                                    value: player-progress;
                                    scrubbed(v) => { player-activity(); }
                                    committed(v) => { player-seek(v); keys.focus(); }
                                }
                                // Chapter gaps, like a segmented bar.
                                for c in player-chapters: Rectangle {
                                    x: parent.width * c - 1.5px;
                                    width: c > 0 ? 3px : 0px;
                                    y: (parent.height - 8px) / 2;
                                    height: 8px;
                                    background: black;
                                }
                            }
                        }
                    }

                    // â”€â”€ Settings sheet â”€â”€
                    if sheet != 0: Rectangle {
                        background: #00000060;
                        TouchArea { clicked => { sheet = 0; keys.focus(); } }
                        Rectangle {
                            width: min(parent.width - 40px, 520px);
                            height: sheet-lay.preferred-height;
                            y: parent.height - self.height - 24px;
                            border-radius: 18px;
                            background: #141418;
                            border-width: 1px;
                            border-color: #ffffff20;
                            TouchArea { }
                            sheet-lay := VerticalLayout {
                                padding: 12px;
                                spacing: 2px;
                                Rectangle { height: 14px; Rectangle { width: 44px; height: 4px; border-radius: 2px; background: #ffffff50; } }
                                if sheet == 1: SheetRow { label: "Quality"; value: ["144p", "240p", "360p", "480p", "720p", "1080p", "1440p", "2160p"][player-quality-index]; clicked => { sheet = 2; } }
                                if sheet == 1: SheetRow { label: "Playback speed"; value: player-speed == 1 ? "Normal" : player-speed + "Ã—"; clicked => { sheet = 3; } }
                                if sheet == 1: SheetRow { label: "Captions"; value: player-captions ? "On" : "Off"; chevron: false; clicked => { player-toggle-captions(); } }
                                if sheet == 1: SheetRow { label: "Sleep timer"; value: player-sleep; clicked => { sheet = 4; } }
                                if sheet == 2: VerticalLayout { spacing: 2px; for q[i] in ["144p", "240p", "360p", "480p", "720p", "1080p", "1440p", "2160p"]: SheetRow {
                                    label: q; chevron: false; selected: i == player-quality-index;
                                    clicked => { player-set-quality(i); sheet = 0; keys.focus(); }
                                } }
                                if sheet == 3: VerticalLayout { spacing: 2px; for sp in [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0]: SheetRow {
                                    label: sp == 1 ? "Normal" : sp + "Ã—"; chevron: false; selected: sp == player-speed;
                                    clicked => { player-set-speed(sp); sheet = 0; keys.focus(); }
                                } }
                                if sheet == 4: VerticalLayout { spacing: 2px; for m[i] in [0, 15, 30, 45, 60, -1]: SheetRow {
                                    label: m == 0 ? "Off" : (m == -1 ? "End of video" : m + " minutes"); chevron: false;
                                    clicked => { player-set-sleep(m); sheet = 0; keys.focus(); }
                                } }
                            }
                        }
                    }
                }
            }

            // â”€â”€ Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            if page == 4: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;
                    alignment: start;
                    Text { text: "Settings"; font-size: 36px; font-weight: 800; color: Theme.fg; }

                    Surface {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            Text { text: "Look"; font-size: 20px; font-weight: 700; color: Theme.fg; }
                            Row { label: "Liquid glass"; Switch { checked <=> Theme.glass; toggled => { settings-changed(); } } }
                            Row { label: "Dark mode"; Switch { checked <=> Theme.dark; toggled => { settings-changed(); } } }
                            Row { label: "Animated aurora"; Switch { checked <=> Theme.aurora; toggled => { settings-changed(); } } }
                            Row {
                                label: "Accent";
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for c in [#ff3d5a, #ff7a1a, #ffc23d, #3ddc84, #1ed6c3, #3d9bff, #6c5cff, #b45cff, #ff5cc8, #e8e8e8]: Swatch {
                                        c: c;
                                        picked(x) => { Theme.accent = x; settings-changed(); }
                                    }
                                }
                            }
                            Row { label: "Corner radius"; Slider { minimum: 0; maximum: 36; value: Theme.radius / 1px; changed(v) => { Theme.radius = v * 1px; settings-changed(); } } }
                            Row { label: "Glass tint"; Slider { minimum: 0; maximum: 0.5; value: Theme.tint; changed(v) => { Theme.tint = v; settings-changed(); } } }
                            Row { label: "Rim light"; Slider { minimum: 0; maximum: 1; value: Theme.rim; changed(v) => { Theme.rim = v; settings-changed(); } } }
                            Row { label: "Grid columns (0 = auto)"; Slider { minimum: 0; maximum: 8; step: 1; value: columns; changed(v) => { columns = round(v); settings-changed(); } } }
                            Row {
                                label: "Window material";
                                ComboBox {
                                    model: ["None", "Mica", "Acrylic"];
                                    current-index <=> effect-index;
                                    selected => { settings-changed(); }
                                }
                            }
                        }
                    }

                    Surface {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            Text { text: "Feed & player"; font-size: 20px; font-weight: 700; color: Theme.fg; }
                            Row { label: "Hide Shorts"; Switch { checked <=> hide-shorts; toggled => { settings-changed(); } } }
                            Row { label: "Hide live streams"; Switch { checked <=> hide-live; toggled => { settings-changed(); } } }
                            Row { label: "Blocked keywords"; LineEdit { text <=> blocked; placeholder-text: "comma, separated"; edited => { settings-changed(); } } }
                            Row {
                                label: "Preferred quality";
                                ComboBox {
                                    model: ["144p", "240p", "360p", "480p", "720p", "1080p", "1440p", "2160p"];
                                    current-index <=> quality-index;
                                    selected => { settings-changed(); }
                                }
                            }
                            Row { label: "Built-in player (libmpv)"; Switch { checked <=> embedded-player; toggled => { settings-changed(); } } }
                            Row { label: "External player command"; LineEdit { text <=> player; edited => { settings-changed(); } } }
                        }
                    }

                    Surface {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            Text { text: "Account & YouTube sync"; font-size: 20px; font-weight: 700; color: Theme.fg; }
                            Text { text: account-label; color: signed-in ? Theme.accent : Theme.muted; font-size: 14px; }
                            Text {
                                text: "Your YouTube session is borrowed from a browser you're already signed in to (or a cookies.txt). No API keys, no Google Cloud.";
                                color: Theme.muted; wrap: word-wrap; font-size: 12px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { text: "Use Firefox"; clicked => { use-browser("firefox"); } }
                                Button { text: "Use Chrome"; clicked => { use-browser("chrome"); } }
                                Button { text: "Use Edge"; clicked => { use-browser("edge"); } }
                                Button { text: "Use Brave"; clicked => { use-browser("brave"); } }
                                Button { text: "Import cookies.txt"; clicked => { import-cookies(); } }
                                if signed-in: Button { text: "Sign out"; clicked => { sign-out(); } }
                            }
                            Row { label: "Send watch history"; Switch { checked <=> send-history; toggled => { settings-changed(); } } }
                        }
                    }

                    Surface {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;
                            Text { text: "For you (session feed)"; font-size: 20px; font-weight: 700; color: Theme.fg; }
                            Text {
                                text: "Home builds its own recommendations from what you watch, search and skip here, no account needed. Recent actions count most.";
                                color: Theme.muted; wrap: word-wrap; font-size: 12px;
                            }
                            Row { label: "Remember between launches"; Switch { checked <=> foryou-remember; toggled => { settings-changed(); } } }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: signal-count + " signals so far"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                                Button { text: "Start fresh"; clicked => { start-fresh(); } }
                                Rectangle { }
                            }
                        }
                    }
                }
            }

            if tune-open: Rectangle {
                background: #000000a8;
                TouchArea { }
                TopicPanel {
                    heading: "Tune your feed";
                    body: "Topics give the feed a head start. What you watch quickly outweighs them.";
                    topics: topics;
                    tuning: true;
                    signed-in: signed-in;
                    toggle(i) => { toggle-topic(i); }
                    build => { save-topics(); }
                    start-fresh => { start-fresh(); }
                    cancel => { cancel-tune(); }
                }
            }

            if loading: Rectangle {
                y: 0;
                height: 3px;
                background: @linear-gradient(90deg, Theme.accent.with-alpha(0) 0%, Theme.accent 50%, Theme.accent.with-alpha(0) 100%);
            }
        }
    }
}
